string standalone.cleanPriceBook()
{
	priceBookID = 6878864000000087665;
	totalDeleted = 0;
	perPage = 200;
	page = 1;
	
	// Используем прямой API вызов через invokeurl
	apiUrl = "https://www.zohoapis.com/crm/v2/Price_Books/" + priceBookID.toString() + "/Price_Book_Product_Details";
	
	while(page <= 20)
	{
		params = Map();
		params.put("page", page);
		params.put("per_page", perPage);
		
		apiResponse = invokeurl
		[
			url: apiUrl
			type: GET
			connection: "zohocrm"
		];
		
		if(apiResponse.get("code") != "SUCCESS" && apiResponse.get("code") != null)
		{
			if(page == 1)
			{
				return "Ошибка API: " + apiResponse.get("message");
			}
			break;
		}
		
		relatedProducts = apiResponse.get("data");
		
		if(relatedProducts == null || relatedProducts.size() == 0)
		{
			if(page == 1)
			{
				return "В прайс-листе нет связанных продуктов для удаления.";
			}
			break;
		}
		
		for each prod in relatedProducts
		{
			prodId = prod.get("id");
			
			if(prodId != null)
			{
				deleteUrl = "https://www.zohoapis.com/crm/v2/Price_Books/" + priceBookID.toString() + "/Price_Book_Product_Details/" + prodId.toString();
				
				deleteResponse = invokeurl
				[
					url: deleteUrl
					type: DELETE
					connection: "zohocrm"
				];
				
				if(deleteResponse.get("code") == "SUCCESS")
				{
					totalDeleted = totalDeleted + 1;
				}
			}
		}
		
		if(relatedProducts.size() < perPage)
		{
			break;
		}
		
		page = page + 1;
	}
	
	return "Очистка завершена. Удалено записей: " + totalDeleted;
}

